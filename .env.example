# Your bot token from https://discord.com/developers/applications (never share it or commit it)
DISCORD_TOKEN=
# Optional: a test server ID so slash commands appear instantly there
GUILD_ID=

# Optional auto-updating status embed (leave blank to turn it off)
STATUS_CHANNEL_ID=
STATUS_HOST=play.example.com
# java, bedrock or auto
STATUS_EDITION=java
# Seconds between updates (minimum 30)
STATUS_INTERVAL=60
